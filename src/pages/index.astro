---
import CubesMark from "../components/CubesMark.astro";
import NextEvent from "../components/NextEvent.astro";
import Qb from "../components/Qb.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublished } from "../lib/content";
import { withBase } from "../lib/url";

const events = await getPublished("events");
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="copy">
        <p class="eyebrow">Welcome to Cubesville</p>
        <h1>
          <CubesMark class="hero-mark" />
          <span class="visually-hidden">{site.name}: </span>{site.fullName}
        </h1>
        <p class="lead">{site.description}</p>
        <div class="actions">
          {
            site.signupUrl && (
              <a class="button button-primary" href={site.signupUrl}>
                Join CUBES
              </a>
            )
          }
          <a class="button button-secondary" href={withBase("/events")}>See events</a>
        </div>
      </div>
      <Qb pose="wave" width={320} alt="QB, the CUBES mascot, waving hello" loading="eager" class="hero-qb" />
    </div>
  </section>

  <section class="container" aria-labelledby="next-up">
    <div class="next">
      <div class="next-head">
        <h2 id="next-up">Next up at CUBES</h2>
        <a href={withBase("/events")}>All events →</a>
      </div>
      <NextEvent events={events} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: var(--space-6);
  }

  h1 {
    display: grid;
    gap: var(--space-4);
  }

  h1 :global(.hero-mark) {
    width: clamp(3.5rem, 8vw, 5rem);
    height: auto;
    color: var(--maroon);
  }

  .lead {
    max-width: 36rem;
    font-size: var(--step-1);
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .hero :global(.hero-qb) {
    justify-self: center;
    width: clamp(180px, 28vw, 320px);
  }

  .next {
    max-width: 40rem;
  }

  .next-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .next-head h2 {
    font-size: var(--step-2);
  }

  @media (max-width: 48rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero :global(.hero-qb) {
      grid-row: 1;
      width: 180px;
    }
  }
</style>
