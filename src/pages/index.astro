---
import { Image } from "astro:assets";
import logo from "../assets/brand/cubes-logo.png";
import qbWave from "../assets/qb/qb-11.webp";
import { withBase } from "../lib/url";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CUBES · Concordia Building Engineering Students</title>
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase("/favicon-192.png")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta
      name="description"
      content="CUBES, the building engineering student society at Concordia University."
    />
  </head>
  <body>
    <main>
      <Image src={logo} alt="CUBES" width={220} />
      <Image src={qbWave} alt="QB, the CUBES mascot, waving" width={180} />
      <h1>Cubesville is under construction</h1>
      <p>
        Follow <a href="https://www.instagram.com/cubes.eca/">@cubes.eca</a> while we build.
      </p>
    </main>
  </body>
</html>

<style>
  :root {
    --maroon: #8e3630;
    --cream: #f4f0dc;
    --ink: #2a1614;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--cream);
    color: var(--ink);
    font-family: system-ui, sans-serif;
    text-align: center;
  }

  main {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 1rem;
  }

  h1 {
    color: var(--maroon);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: clamp(1.25rem, 4vw, 2rem);
  }

  a {
    color: var(--maroon);
  }
</style>
