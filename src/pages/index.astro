---
import CubesMark from "../components/CubesMark.astro";
import Qb from "../components/Qb.astro";
import { NAV } from "../data/nav";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/url";
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="copy">
        <p class="eyebrow">Welcome to Cubesville</p>
        <h1>
          <CubesMark class="hero-mark" />
          <span class="visually-hidden">{site.name}: </span>{site.fullName}
        </h1>
        <p class="lead">{site.description}</p>
        <div class="actions">
          {
            site.signupUrl && (
              <a class="button button-primary" href={site.signupUrl}>
                Join CUBES
              </a>
            )
          }
          <a class="button button-secondary" href={withBase("/events")}>See events</a>
        </div>
      </div>
      <Qb pose="wave" width={320} alt="QB, the CUBES mascot, waving hello" loading="eager" class="hero-qb" />
    </div>
  </section>

  <section class="container">
    <h2 class="visually-hidden">Explore Cubesville</h2>
    <ul class="tiles">
      {
        NAV.map((item) => (
          <li>
            <a class="tile" href={withBase(item.href)}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: var(--space-6);
  }

  h1 {
    display: grid;
    gap: var(--space-4);
  }

  h1 :global(.hero-mark) {
    width: clamp(3.5rem, 8vw, 5rem);
    height: auto;
    color: var(--maroon);
  }

  .lead {
    max-width: 36rem;
    font-size: var(--step-1);
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .hero :global(.hero-qb) {
    justify-self: center;
    width: clamp(180px, 28vw, 320px);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tile {
    display: flex;
    align-items: end;
    min-height: 6rem;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow);
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
    color: var(--maroon);
    transition: transform 0.15s;
  }

  .tile:hover {
    transform: translateY(-2px);
  }

  @media (max-width: 48rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero :global(.hero-qb) {
      grid-row: 1;
      width: 180px;
    }
  }
</style>
