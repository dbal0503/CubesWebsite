---
import { NAV } from "../data/nav";
import { site } from "../data/site";
import { withBase } from "../lib/url";
import CubesMark from "./CubesMark.astro";
import SocialLinks from "./SocialLinks.astro";

const current = Astro.url.pathname.replace(/\/$/, "");
const isCurrent = (href: string) => current === withBase(href).replace(/\/$/, "");
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={withBase("/")}>
      <CubesMark class="brand-mark" />
      <span class="brand-name">{site.name}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="visually-hidden">Menu</span>
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main" data-menu>
      <ul class="nav-links">
        {
          NAV.map((item) => (
            <li>
              <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-actions">
        <SocialLinks />
        {
          site.signupUrl && (
            <a class="button button-primary" href={site.signupUrl}>
              Join CUBES
            </a>
          )
        }
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    menu?.toggleAttribute("data-open", !open);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.hasAttribute("data-open")) {
      toggle?.setAttribute("aria-expanded", "false");
      menu.removeAttribute("data-open");
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--maroon);
  }

  .brand :global(.brand-mark) {
    width: 2rem;
    height: 2rem;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: var(--tracking-wide);
  }

  .nav {
    display: flex;
    align-items: center;
    flex: 1;
    gap: var(--space-5);
  }

  .nav-links {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }

  .nav-links a:hover {
    background: var(--paper);
    color: var(--maroon);
  }

  .nav-links a[aria-current="page"] {
    background: var(--maroon);
    color: var(--cream);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
    color: var(--maroon);
  }

  .menu-toggle {
    display: none;
    margin-left: auto;
    padding: var(--space-2);
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--maroon);
    cursor: pointer;
  }

  @media (max-width: 64rem) {
    .menu-toggle {
      display: grid;
    }

    .nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-4);
      background: var(--cream);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .nav[data-open] {
      display: flex;
    }

    .nav-links {
      flex-direction: column;
    }

    .nav-links a {
      padding: var(--space-3) var(--space-4);
      font-size: var(--step-0);
    }

    .nav-actions {
      margin-left: 0;
      justify-content: space-between;
    }
  }
</style>
