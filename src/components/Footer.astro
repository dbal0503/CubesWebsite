---
import { NAV } from "../data/nav";
import { site } from "../data/site";
import { withBase } from "../lib/url";
import CubesMark from "./CubesMark.astro";
import Qb from "./Qb.astro";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="site-footer">
  <div class="container grid">
    <div class="about">
      <a class="brand" href={withBase("/")}>
        <CubesMark class="brand-mark" />
        <span>{site.name}</span>
      </a>
      <p>{site.fullName}</p>
      <p class="muted">{site.office}</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="eyebrow">Explore</h2>
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={withBase(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow">Get involved</h2>
      <ul>
        {
          site.signupUrl && (
            <li>
              <a href={site.signupUrl}>Join CUBES</a>
            </li>
          )
        }
        <li><a href={withBase("/shop")}>Buy merch</a></li>
        <li><a href={withBase("/sponsors")}>Sponsor us</a></li>
        {
          site.contactEmail && (
            <li>
              <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
            </li>
          )
        }
      </ul>
      <SocialLinks class="footer-socials" />
    </div>
  </div>
  <div class="container fine-print">
    <p>© {new Date().getFullYear()} {site.name} · Concordia University</p>
    <Qb pose="peeking" width={110} class="peeking-qb" />
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--space-8);
    padding-block: var(--space-7) var(--space-5);
    background: var(--maroon-deep);
    color: var(--cream);
  }

  /* QB's hands rest on the divider line. The pose is bone-white, so it stays on the maroon. */
  .site-footer :global(.peeking-qb) {
    position: absolute;
    right: 0;
    bottom: calc(100% - 2px);
    width: clamp(80px, 10vw, 110px);
  }

  .grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
    color: var(--cream);
    font-family: var(--font-heading);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
  }

  .brand :global(.brand-mark) {
    width: 2.25rem;
    height: 2.25rem;
  }

  .eyebrow {
    color: color-mix(in srgb, var(--cream) 70%, transparent);
  }

  ul {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  li {
    margin-block: var(--space-2);
  }

  a {
    color: var(--cream);
    overflow-wrap: anywhere;
  }

  a:hover {
    color: #fff;
  }

  .muted,
  .fine-print {
    color: color-mix(in srgb, var(--cream) 75%, transparent);
  }

  .site-footer :global(.footer-socials) {
    margin-left: calc(-1 * var(--space-2));
  }

  .fine-print {
    position: relative;
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    border-top: 1px solid color-mix(in srgb, var(--cream) 35%, transparent);
    font-size: var(--step--1);
  }

  .fine-print p {
    margin: 0;
  }
</style>
